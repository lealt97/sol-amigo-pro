# Browser-safe values only. Never add service-role keys or payment secrets here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Root deployment (Cloudflare Pages). GitHub Pages still uses /sol-amigo-pro/ in its workflow.
VITE_BASE_PATH=/
# Set the final application URL before generating public proposal links.
VITE_PUBLIC_APP_URL=https://app.YOUR_DOMAIN.com.br/
